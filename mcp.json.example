{
  "_comment": "Copy to .mcp.json (project-local) or merge into ~/.claude/settings.json. Credentials live in .env, not here — the server reads .env from the directory containing dist/ (the repo/package root), so it is found regardless of the MCP client's working directory. autoApprove lists READ-ONLY tools only — destructive tools (tm1_rest_write, tm1_files_write, delete/clear/execute/write/set/upsert/import) MUST stay out of this list and require manual approval. TM1_SSL_REJECT_UNAUTHORIZED defaults to true; set it false only for self-signed dev certs, never in production.",
  "mcpServers": {
    "tm1": {
      "command": "node",
      "args": ["/absolute/path/to/tm1-mcp-server/dist/index.js"],
      "autoApprove": [
        "tm1_analyze_callgraph",
        "tm1_analyze_chore_graph",
        "tm1_analyze_object_usage",
        "tm1_audit_complexity",
        "tm1_audit_feeders",
        "tm1_audit_naming",
        "tm1_check_cube_rule",
        "tm1_check_feeders",
        "tm1_check_process_code",
        "tm1_check_v12_readiness",
        "tm1_check_writable_coords",
        "tm1_compare_environments",
        "tm1_diagnose_process_error",
        "tm1_diff_cube_rules",
        "tm1_diff_hierarchy",
        "tm1_diff_process_with_file",
        "tm1_diff_processes",
        "tm1_execute_mdx",
        "tm1_export_process_to_git",
        "tm1_export_process_to_pro",
        "tm1_files_read",
        "tm1_get_all_cube_rules",
        "tm1_get_all_processes_code",
        "tm1_get_cube_rules",
        "tm1_get_cube_stats",
        "tm1_get_error_log_content",
        "tm1_get_process",
        "tm1_get_server_state",
        "tm1_get_view",
        "tm1_list_connections",
        "tm1_list_error_logs",
        "tm1_list_processes_grouped",
        "tm1_resolve_default_members",
        "tm1_rest_read",
        "tm1_sample_cells",
        "tm1_search_code",
        "tm1_search_rules",
        "tm1_trace_cell_calculation",
        "tm1_trace_data_flow",
        "tm1_trace_feeders",
        "tm1_validate_process_refs"
      ]
    }
  }
}
