{
  "_comment": "Copy to .mcp.json (project-local) or merge into ~/.claude/settings.json. Credentials live in .env, not here — the server reads .env from the directory containing dist/ (the repo/package root). Tool permissions are set in Claude Code settings (permissions.allow), not here. TM1_SSL_REJECT_UNAUTHORIZED defaults to true; set it false only for self-signed dev certs, never in production.",
  "mcpServers": {
    "tm1": {
      "command": "node",
      "args": ["/absolute/path/to/tm1-mcp-server/dist/index.js"]
    }
  }
}
