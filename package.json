{
  "name": "@ffschrattenecker/tm1-mcp-server",
  "version": "9.2.0",
  "description": "Personal testing fork of flameY3T1/tm1-mcp-server (npm: tm1-mcp-server). Use the original.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ffschrattenecker/tm1-mcp-server.git"
  },
  "author": "flameY3T1",
  "contributors": [
    "ffschrattenecker (fork maintainer)"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tm1-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs",
    "NOTICE",
    "npm-shrinkwrap.json"
  ],
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "rm -rf dist && npm run build",
    "prepublishOnly": "npm run verify",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:for": "tsx scripts/run-live-for.ts",
    "contracts:record": "node scripts/record-wire-contracts.mjs",
    "contracts:verify": "node scripts/record-wire-contracts.mjs --verify",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint:output-schema-budget": "node scripts/check-output-schema-budget.mjs",
    "lint:conventions": "node scripts/check-conventions.mjs",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run audit:prod && npm run typecheck && npm run typecheck:tests && npm run lint:output-schema-budget && npm run lint:conventions && npm run lint:tool-docs && npm run lint:format && npm run lint:eslint && npm test",
    "tools:list": "node scripts/gen-tool-list.mjs",
    "tools:update-readme": "node scripts/gen-tool-list.mjs --write-readme",
    "lint:tool-docs": "node scripts/gen-tool-list.mjs --check",
    "lint:eslint": "eslint ."
  },
  "keywords": [
    "mcp",
    "tm1",
    "planning-analytics",
    "ibm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "fast-uri": "^4.2.1",
    "ip-address": "^10.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@napi-rs/keyring": "^2.1.0",
    "dotenv": "^18.0.0",
    "pino": "^10.3.1",
    "regexp-tree": "^0.1.27",
    "safe-regex": "^2.1.1",
    "undici": "^8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/safe-regex": "^1.1.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
